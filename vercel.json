{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "app/main.py",
      "rewrites": [{ "source": "/api/:path(.*)?", "destination": "/:path" }]
    },
    "frontend": {
      "root": "frontend"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
